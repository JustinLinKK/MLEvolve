{
  "aging_interval_seconds": 180.0,
  "aging_priority_increment": 1,
  "auto_resume_recoverable": false,
  "baseline_cache": {
    "entry_capacity": 0,
    "max_ram_percent": null,
    "memory_budget_bytes": 2147483648,
    "warm_queue_policy": "top_k",
    "warm_queue_top_k": 0
  },
  "cache_server_host": "127.0.0.1",
  "cache_server_port": 8765,
  "cache_socket_name": "cache_server.sock",
  "command_poll_limit": 100,
  "enable_priority_aging": true,
  "gpu_scheduler": {
    "adaptive": {
      "exact_search_max_jobs": 8,
      "finalist_limit": 64,
      "frontier_width": 32,
      "minimum_throughput_gain_fraction": 0.05,
      "replan_debounce_seconds": 1.0,
      "vram_bucket_mb": 128
    },
    "backend_priority": [
      "cuda_process",
      "stream",
      "exclusive"
    ],
    "batch_probe_enabled": true,
    "batch_probe_max_batch_size": 256,
    "batch_probe_max_search_rounds": 14,
    "batch_probe_min_batch_size": 32,
    "batch_probe_search_mode": "power_of_two",
    "candidate_window_size": 16,
    "checkpoint_preemption_cooldown_seconds": 60.0,
    "checkpoint_preemption_enabled": false,
    "checkpoint_preemption_max_per_job": 3,
    "checkpoint_preemption_min_estimated_gain_seconds": 15.0,
    "checkpoint_preemption_min_runtime_seconds": 15.0,
    "checkpoint_preemption_overhead_multiplier": 2.0,
    "checkpoint_preemption_pause_timeout_seconds": 60.0,
    "cuda_process": {
      "default_mkl_num_threads": 2,
      "default_omp_num_threads": 2,
      "enabled": true
    },
    "derivative_profile_safety_fraction": 0.85,
    "device_index": 0,
    "early_stop": {
      "direction": "auto",
      "enabled": false,
      "metric_key": null,
      "min_delta": 0.0001,
      "min_global_step": 20,
      "min_runtime_seconds": 120.0,
      "patience_samples": 10,
      "plot_enabled": false,
      "warmup_samples": 10
    },
    "enabled": true,
    "fallback_cooldown_seconds": 900,
    "max_packed_jobs_per_gpu": 8,
    "memory": {
      "vram_budget_fraction": 0.9166666666666666
    },
    "mode": "adaptive",
    "model_family_probe_enabled": false,
    "model_family_probe_priority": 100,
    "model_family_probe_timeout_seconds": 300,
    "mps": {
      "compute_mode": "EXCLUSIVE_PROCESS",
      "default_mkl_num_threads": 6,
      "default_omp_num_threads": 6,
      "default_primary_active_thread_pct": 60,
      "default_secondary_active_thread_pct": 40,
      "enabled": false,
      "log_directory": "/tmp/nvidia-mps-log",
      "pipe_directory": "/tmp/nvidia-mps"
    },
    "profiling": {
      "pair_probe_steps": 60,
      "reuse_profile_if_confidence_ge": 0.8,
      "solo_probe_steps": 5,
      "warmup_steps": 2
    },
    "stream": {
      "enabled": true,
      "host_join_timeout_seconds": 5.0,
      "host_poll_interval_seconds": 0.1
    },
    "submission_defaults": {
      "backend_allowlist": [
        "cuda_process",
        "stream"
      ],
      "batch_probe_enabled": true,
      "batch_probe_max_multiplier": 32,
      "batch_probe_model_key": null,
      "batch_probe_optimizer_steps": 1,
      "batch_probe_poll_interval_seconds": 0.5,
      "batch_probe_probe_timeout_seconds": 45,
      "batch_probe_search_mode": "power_of_two",
      "batch_probe_startup_timeout_seconds": 90,
      "batch_probe_step_timeout_seconds": 30,
      "estimated_ram_mb": null,
      "estimated_vram_mb": null,
      "packing_eligible": true,
      "packing_family": "standard_histopath_v1",
      "packing_max_slowdown_ratio": null,
      "requires_gpu": true,
      "runtime_probe_enabled": true,
      "runtime_probe_model_key": null,
      "runtime_probe_strategy": "epoch_1",
      "runtime_probe_target": null
    },
    "telemetry": {
      "device_poll_ms": 1000,
      "pair_recheck_every_steps": 20
    },
    "thresholds": {
      "latency_sensitive_max_slowdown": 1.15,
      "min_aggregate_gain": 1.1,
      "pack_prefer_sm_active_lt": 0.5,
      "pack_reject_max_slowdown": 1.3,
      "pack_reject_sm_active_ge": 0.8
    }
  },
  "log_db": {
    "dsn_env": "LOCALML_SCHEDULER_LOG_DSN",
    "enabled": false,
    "provider": "postgres",
    "schema": "scheduler_logs"
  },
  "prediction": {
    "branch": {
      "enabled": true,
      "fixed_confidence_if_uncalibrated": 0.55
    },
    "fallback_to_exclusive": true,
    "ml": {
      "cache_size": 1024,
      "calibration_path": null,
      "checkpoint_path": null,
      "device": "cpu",
      "enabled": false,
      "hardware_key": null
    },
    "mode": "branch_profile",
    "safety_margin": {
      "branch": 1.2,
      "explicit": 1.3,
      "job_local_probe": 1.1,
      "ml_calibrated": 1.0,
      "ml_uncalibrated": 1.25
    },
    "timeout_ms": 1000,
    "unknown_value_policy": null
  },
  "preempt_check_interval_seconds": 0.5,
  "python_executable": "/opt/conda/bin/python",
  "redis_cache": {
    "cache_graph_queries": true,
    "enabled": false,
    "key_prefix": "localml_scheduler",
    "max_entries": 4096,
    "socket_timeout_seconds": 0.2,
    "ttl_seconds": 300,
    "url": "redis://127.0.0.1:6379/0",
    "url_env": "LOCALML_SCHEDULER_REDIS_URL"
  },
  "runtime_root": "scheduler_benchmark_runtime",
  "scheduler_poll_interval_seconds": 0.2,
  "scheduler_session_id": null,
  "sqlite_busy_timeout_ms": 10000
}
